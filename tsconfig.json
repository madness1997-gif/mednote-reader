{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": ["src", "app/page.tsx", "app/pdf-reader.tsx", "app/pdfium-renderer.ts", "app/pdf-worker.d.ts", "app/note-domain.ts", "app/document-domain.ts", "app/note-repository.ts", "app/document-repository.ts", "app/indexeddb-note-repository.ts", "app/note-migration.ts", "app/v5-storage-import.ts", "app/relation-v2-migration.ts", "vite.github.config.ts", "vite.desktop.config.ts", "vite.pdf-assets.ts"]
}
