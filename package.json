{
  "name": "mednote-reader",
  "version": "1.2.9",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --config vite.github.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test:wave1": "node --import tsx --test tests-unit/wave1.test.ts && npm run test:wave1:large",
    "test:wave1:large": "node --expose-gc --import tsx --test tests-unit/wave15-large.test.ts",
    "test:wave2": "node --import tsx --test tests-unit/wave2.test.ts",
    "test:wave3": "node --import tsx --test tests-unit/wave3.test.ts",
    "test:all": "playwright test",
    "build:pages": "vite build --config vite.github.config.ts",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@hyzyla/pdfium": "2.1.13",
    "html2canvas": "1.4.1",
    "lucide-react": "0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "22.15.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.2",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "build": {
    "appId": "vn.mednote.reader",
    "productName": "MedNote Reader",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MedNote-Reader-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
